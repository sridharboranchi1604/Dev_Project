{
  "rules": {
    "locations": {
      "$uid": {
        ".write": "auth != null && auth.token.firebase.sign_in_provider == 'anonymous' && auth.uid == $uid",
        ".read": "auth != null && auth.token.email != null",
        ".validate": "newData.hasChildren(['uid','sessionId','latitude','longitude','accuracy','timestamp']) && newData.child('uid').val() == $uid && newData.child('latitude').isNumber() && newData.child('longitude').isNumber()"
      }
    }
  }
}
